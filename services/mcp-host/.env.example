# Where the connection records live. TLS is decided by sslmode in the URL.
DATABASE_URL=postgres://bursar:bursar@127.0.0.1:55432/bursar

# The key that seals every agent key at rest: 32 bytes of hex. Generate one with
#   node -e "console.log('0x' + require('node:crypto').randomBytes(32).toString('hex'))"
# and keep it where you keep a signing key. Losing it makes every connection unreadable.
MCP_HOST_KEK=

# Where it listens, and the address connectors are told to use.
MCP_HOST_HOST=127.0.0.1
MCP_HOST_PORT=8410
MCP_HOST_PUBLIC_URL=http://127.0.0.1:8410

# Two independent endpoints, as every Bursar service reads them.
RHC_RPC_PRIMARY=https://rpc.mainnet.chain.robinhood.com
RHC_RPC_FALLBACK=https://robinhood.drpc.org

# Requests one token may make per minute, and connections one owner may open per hour.
MCP_HOST_TOKEN_RPM=120
MCP_HOST_CONNECTIONS_PER_HOUR=20

# Key for the network index, which mandate_list_settlements reads. Every other tool works without it.
BLOCKSCOUT_API_KEY=

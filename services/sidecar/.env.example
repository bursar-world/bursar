# The provider's own key. It signs this payee's releases and nothing else.
PAYEE_PRIVATE_KEY=

# Where the capability implementations are served.
API_BASE=http://127.0.0.1:8787

# Two independent providers, because one metered provider is one outage. The fallback below
# is the default and needs no key; the service refuses to start if both resolve to one host.
RHC_RPC_PRIMARY=https://rpc.mainnet.chain.robinhood.com
RHC_RPC_FALLBACK=https://robinhood.drpc.org

# Mainnet is the only network that settles: USDG holds no code on 46630, so testnet is refused
# at startup. Point RHC_MAINNET_RPC_URL at a fork of 4663 to run against one.
RHC_NETWORK=mainnet

# The escrow comes from the deployment record for the chain. Until one is recorded for 4663,
# set it here.
# ESCROW_ADDRESS=

# A payee with open locks on an earlier deployment answers both escrows from one process:
# list them here, comma-separated. Each keeps its own outputs and cursor.
# ESCROW_ADDRESSES=0x4315F8be7C9661345710910577Ec31cb867f3c20,0x7D82Ad9Dc36734AdCF5Cf985295096b2b575C8C4

CAPABILITIES_PATH=capabilities.json
OUTPUT_DIR=./out

# Public base for outputs too large to carry in calldata. Leave unset to send the
# commitment alone and hand the bytes over off-chain.
# OUTPUT_BASE_URL=https://outputs.example.com/jobs

# Hosts an input URI may be fetched from. Nothing else is, loopback included.
# ALLOWED_HOSTS=inputs.example.com

# Warn when the gas balance falls below this many wei of ETH. Gas is ETH on 4663 and is not
# the asset locks are denominated in, so this is a separate balance on a separate key. The
# value below is 0.004 ETH; pick a floor from your own release rate, because nothing here can
# know it.
MIN_GAS_WEI=4000000000000000

# Contest a lock whose deadline passed after the work was delivered. Posting the bond
# risks it, so both variables have to be set together.
# ESCALATE_EXPIRED=true
# ESCALATE_MAX_BOND=250000

# The resolver service's evidence inbox. When a payer disputes a job this payee delivered but has
# not yet released, the sidecar signs what it delivered and posts it here, so the resolvers see
# the work. The output has to be fetchable, inline or under OUTPUT_BASE_URL.
# SIDECAR_EVIDENCE_URL=https://app.bursar.world/api/evidence

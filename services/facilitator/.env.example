# The ledger. TLS is decided by sslmode in the URL.
DATABASE_URL=postgres://bursar:bursar@127.0.0.1:55432/bursar

# Two independent providers, because one metered provider is one outage. The fallback is the
# keyless endpoint for the network and may be left out; the service refuses two names for one host.
RHC_RPC_PRIMARY=https://rpc.mainnet.chain.robinhood.com
RHC_RPC_FALLBACK=https://robinhood.drpc.org

# Where it listens. Anything but loopback needs FACILITATOR_AUTH_TOKEN.
FACILITATOR_HOST=127.0.0.1
FACILITATOR_PORT=8402

# The provider token opens the six routes a provider's resource server calls: /verify, /settle,
# /supported, /config, /healthz and /readyz. At least 32 characters.
FACILITATOR_AUTH_TOKEN=

# The admin token opens every other route: accounts, pools, lanes, authorisations, underwriting,
# reservations, settlement batches and the trust journal. The provider token is never accepted
# there. Give it its own value, at least 32 characters; unset, those routes answer admin_token_unset.
FACILITATOR_ADMIN_TOKEN=

# The relayer's key, and the only key this service holds. It must sign for FACILITATOR_GAS_FLOAT,
# and the four funding roles each need their own address.
FACILITATOR_RELAYER_KEY=
FACILITATOR_GAS_FLOAT=
FACILITATOR_SETTLEMENT=
FACILITATOR_COLLATERAL=
FACILITATOR_TREASURY=

# The relayer's ETH reserve, written as ETH. Health reports degraded below it.
FACILITATOR_GAS_FLOAT_MINIMUM_ETH=0.004

# The fee on each settle this service broadcasts, and the smallest fee a broadcast is spent on.
FACILITATOR_FEE_BPS=100
FACILITATOR_FEE_FLOOR_MICRO=1900

# The Base lane, off until a key is set. The key's address holds the USDC float on Base and is the
# payee of every lock the lane opens on Robinhood Chain. The four money settings come with it.
# FACILITATOR_BASE_KEY=
# FACILITATOR_BASE_FEE_BPS=100
# FACILITATOR_BASE_FEE_FLOOR_MICRO=2000
# FACILITATOR_BASE_FLOAT_MINIMUM_MICRO=1000000
# FACILITATOR_BASE_MAX_PAYMENT_MICRO=5000000
# FACILITATOR_BASE_RPC_URL=https://base.drpc.org

# Where spend decisions come from: BURSAR_UNDERWRITER_URL for an underwriter over HTTP,
# MANDATE_DOCUMENT_SOURCE to run one in this process, or none for a facilitator that only settles.
FACILITATOR_UNDERWRITER=none
# BURSAR_UNDERWRITER_URL=http://127.0.0.1:8403
# BURSAR_UNDERWRITER_TOKEN=

{
  "name": "@bursar/facilitator",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bursar-world/bursar.git",
    "directory": "services/facilitator"
  },
  "homepage": "https://github.com/bursar-world/bursar/tree/main/services/facilitator#readme",
  "bugs": {
    "url": "https://github.com/bursar-world/bursar/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "migrations"
  ],
  "bin": {
    "bursar-facilitator": "./dist/main.js",
    "bursar-facilitator-migrate": "./dist/db/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node dist/main.js",
    "migrate": "node dist/db/cli.js",
    "migrate:dry-run": "node dist/db/cli.js --dry-run",
    "keeper": "node dist/collateral/keeper-main.js"
  },
  "dependencies": {
    "@bursar/core": "workspace:*",
    "@bursar/underwriter": "workspace:*",
    "@bursar/x402": "workspace:*",
    "pg": "8.23.1",
    "viem": "2.57.2"
  },
  "devDependencies": {
    "@bursar/sdk": "workspace:*",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=22"
  }
}

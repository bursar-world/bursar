{
  "name": "@bursar/asp",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bursar-world/bursar.git",
    "directory": "services/asp"
  },
  "homepage": "https://github.com/bursar-world/bursar/tree/main/services/asp#readme",
  "bugs": {
    "url": "https://github.com/bursar-world/bursar/issues"
  },
  "description": "Bursar's association-set provider for the shielded USDG pool: admits every deposit whose depositor the Robinhood access registry does not block, posts the root, and serves the set.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "bursar-asp": "./bin/bursar-asp.mjs"
  },
  "files": [
    "bin",
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "start": "node dist/main.js run",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@bursar/core": "workspace:*",
    "@bursar/sdk": "workspace:*",
    "viem": "2.56.3"
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=22"
  }
}

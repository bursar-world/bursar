# WalletConnect project id. Without it the WalletConnect option is hidden and the
# injected-wallet and Safe paths still work.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# RPC endpoints. Both default to the recorded Robinhood Chain mainnet pair and must sit at
# different hosts: two names for one endpoint is one endpoint, one rate meter and no second
# opinion. The build refuses two copies of one host, and refuses a value that is not an http or
# https URL. The fallback needs no key, so an unconfigured checkout still has somewhere to go.
NEXT_PUBLIC_RHC_RPC_PRIMARY=https://rpc.mainnet.chain.robinhood.com
NEXT_PUBLIC_RHC_RPC_FALLBACK=https://robinhood.drpc.org

# Which Robinhood Chain network this build talks to. Unset means mainnet, chain 4663, which is
# where BURSAR settles. Setting it to testnet is refused: USDG has no contract on chain 46630, so
# nothing there can settle a payment. Testing runs against a local fork of 4663.
NEXT_PUBLIC_RHC_NETWORK=

# The explorer readers are sent to for a transaction or an address. Unset takes the one recorded
# for the network. Set it when that host moves, which is a configuration change rather than a
# release. It governs links only: nothing in this app fetches it.
NEXT_PUBLIC_RHC_EXPLORER=

# Where this app is served from, shown by wallets that ask before they sign. Only needed in a
# deployment: the browser reads its own origin, and this is what the server render uses.
NEXT_PUBLIC_SITE_URL=

# The key for the network index, which is what the settlement history and the revert reasons are
# read from. Robinhood Chain's index is paid and answers 402 without one. This variable carries no
# NEXT_PUBLIC_ prefix on purpose: it is read by the /api/index route on the server and never
# reaches a browser. Without it every history surface says so and names this variable; balances,
# limits and permissions are read from the contracts and keep working.
BLOCKSCOUT_API_KEY=

# The index this deployment reads, if it is not the one for the chain above. Server-side, and
# never the explorer a reader clicks through to: that host answers a challenge meant for a person.
BLOCKSCOUT_API_BASE=

# Relay, which carries funding from Base, Arc and Solana into a mandate. Quotes and status checks
# work without a key. A key from dashboard.relay.link gives this deployment its own rate limit and
# unlocks deposit addresses on Solana. Server-side only, like the index key above.
RELAY_API_KEY=

# A local rehearsal of the deployment, against anvil started with `anvil --chain-id 4663`.
#
#   source script/env/local.env                 # from contracts/
#
# Every figure is the mainnet one. What changes is where the record lives, the flag that lets
# the scripts accept a local record, and the roles, which are anvil's own unlocked accounts where a
# key has to sign and plain placeholders where an address only receives.

source script/env/rhc-mainnet-v4.env

export BURSAR_LOCAL=1
export BURSAR_RECORD=cache/bursar/local/local-4663.json

# Forge builds, logs each run's transactions, and keeps the endpoint `--resume` sends to, under
# cache/bursar/local, apart from the out/, broadcast/ and cache/ a real run keeps. A local chain
# answers as 4663 too, so without this a local run would overwrite the log a stopped mainnet step
# resumes from. The first command in a new shell builds from scratch.
export FOUNDRY_OUT=cache/bursar/local/out
export FOUNDRY_CACHE_PATH=cache/bursar/local/cache
export FOUNDRY_BROADCAST=cache/bursar/local/broadcast
# Forge's test preprocessing leaves artifacts behind that every later command warns about.
export FOUNDRY_DYNAMIC_TEST_LINKING=false
# Local runs sign with anvil's unlocked accounts. Forge reads ETH_PASSWORD as a keystore's password
# file and refuses an --unlocked run while it is set.
unset ETH_PASSWORD

# anvil's default accounts 0 to 3: the deploy key and the three signers.
export BURSAR_DEPLOYER=0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266
export BURSAR_TIMELOCK_SIGNER_1=0x70997970C51812dc3A010C7d01b50e0d17dc79C8
export BURSAR_TIMELOCK_SIGNER_2=0x3C44CdDdB6a900fa2b585dd299e03d12FA4293BC
export BURSAR_TIMELOCK_SIGNER_3=0x90F79bf6EB2c4f870365E785982E1f101E93b906
export BURSAR_ALLOW_EOA_GOVERNANCE=i-accept-eoa-governance

export BURSAR_TIMELOCK_GUARDIAN=0x15d34AAf54267DB7D7c367839AAf71A00a2C6A65
export BURSAR_TREASURY=0x9965507D1a55bcC2695C58ba16FB37d819B0A4dc
export BURSAR_SLASH_SINK=0x976EA74026E726554dB657fA54763abd0C3a0aa9
export BURSAR_BRSR_LIQUIDITY=0x14dC79964da2C08b23698B3D3cc7Ca32193d9955
export BURSAR_BRSR_COMMUNITY=0x23618e81E3f5cdF7f54C3d65f7FBc0aBf5B21E8f

# BRSR and its vesting schedule do not exist on a fresh chain, so the rehearsal mints them.
export BURSAR_VESTING_BENEFICIARIES=0xa0Ee7A142d267C1f36714E4a8F75612F20a79720
export BURSAR_VESTING_AMOUNTS=100000000000000000000000000
export BURSAR_VESTING_START="$(date +%s)"

export BURSAR_RESOLVERS=0x0000000000000000000000000000000000001001,0x0000000000000000000000000000000000001002,0x0000000000000000000000000000000000001003
export BURSAR_LENDER=0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266
export BURSAR_SOLVENCY_POSTER=0xf39Fd6e51aad88F6F4ce6aB8827279cffFb92266
export BURSAR_ASP_POSTMAN=0x0000000000000000000000000000000000002001
export BURSAR_SHIELDED_RELAYER=0x0000000000000000000000000000000000002002

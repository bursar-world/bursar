# Bursar on Robinhood Chain 4663: the figures for the v3 deployment.
#
#   source script/env/rhc-mainnet-v3.env        # from contracts/
#
# Addresses are not here. The record at BURSAR_RECORD names the settlement asset, the outside
# contracts, the governance roles and the resolvers, and every script reads the contracts earlier
# scripts deployed from it. This file holds what each run decides: fees, windows, caps, bonds, and
# the few operators a script records the first time it needs them. A figure set here is written
# into the record's `parameters` as applied, which is what the verify scripts hold the chain to.
#
# This is a development deployment: the timelock waits one hour, and every figure below is on the
# checklist for review before launch.

export BURSAR_RECORD=deployments/rhc-mainnet-v3.json

# Robinhood Chain's public endpoint. A shell that already names another endpoint for the chain
# keeps it.
export RHC_RPC_URL="${RHC_RPC_URL:-https://rpc.mainnet.chain.robinhood.com}"

# --- Deploy.s.sol: governance, escrow, reputation, resolvers, agents ---

# One hour between two signers agreeing and the change taking effect. A principal can pause a
# mandate or pull its funds inside it; stakes and bonds take seven days to leave whatever it is.
export BURSAR_TIMELOCK_PERIOD=3600

# One percent of a settlement to the protocol, half a percent to the resolvers who rule on a
# dispute, and five percent of a disputed amount posted by whoever opens the dispute.
export BURSAR_FEE_BPS=100
export BURSAR_RESOLVER_FEE_BPS=50
export BURSAR_DISPUTE_BOND_BPS=500

# A job's deadline sits between five minutes and seven days. For an hour after a release the payer
# can still complain: that goes on the payee's history, takes no bond and is never ruled on,
# because the payee has been paid. The smallest payment is one cent, so the bond on any disputed
# payment comes to at least one unit.
export BURSAR_MIN_TTL=300
export BURSAR_MAX_TTL=604800
export BURSAR_DISPUTE_WINDOW=3600
export BURSAR_MIN_LOCK=10000

# What one payee can be paid: 25 USDG with no history, 2.25 USDG more per point of reputation, up
# to 250 USDG, which a perfect score of 100 reaches.
export BURSAR_CAP_BASE=25000000
export BURSAR_CAP_PER_SCORE=2250000
export BURSAR_CAP_MAX=250000000

# An hour to commit a sealed score and an hour to reveal it. Two votes decide, and every seated
# resolver may vote, up to 64. Twenty points from the consensus costs a resolver a tenth of its bond.
export BURSAR_COMMIT_WINDOW=3600
export BURSAR_REVEAL_WINDOW=3600
export BURSAR_UNBONDING_PERIOD=604800
export BURSAR_RESOLVER_QUORUM=2
export BURSAR_MAX_VOTERS=64
export BURSAR_MAX_DEVIATION=20
export BURSAR_RESOLVER_SLASH_BPS=1000

# Providers stake 5 USDG to be paid through the escrow. A ruling never touches the stake: only
# governance can take any of it, by a proposal that names the amount, and no more than a tenth at a
# time.
export BURSAR_DEPLOY_AGENT_REGISTRY=true
export BURSAR_AGENT_MIN_STAKE=5000000
export BURSAR_AGENT_SLASH_BPS=1000

# The signer set is three plain keys by operator decision. The deploy script refuses that unless
# this is set to the phrase below, in the shell that runs the deploy and nowhere else:
#   export BURSAR_ALLOW_EOA_GOVERNANCE=i-accept-eoa-governance

# --- DeployStaking.s.sol: staking pool, buyback, seeder ---

# Seven days to leave the staking pool. Nobody can bond as a resolver until governance names a
# floor for them: the floor for everyone else is more BRSR than exists. Each vetted resolver's
# floor is 30,000 BRSR.
export BURSAR_STAKING_UNBONDING_PERIOD=604800
export BURSAR_STAKING_MIN_BOND=1000000000000000000000000000
export BURSAR_RESOLVER_BOND_FLOOR=30000000000000000000000

# The BRSR/USDG pool the buyback trades: the 0.30% tier with no hook, the pool already open on
# chain. These five values are fixed in the buyback for good.
export BURSAR_BUYBACK_POOL_FEE=3000
export BURSAR_BUYBACK_POOL_TICK_SPACING=60
export BURSAR_BUYBACK_POOL_HOOKS=0x0000000000000000000000000000000000000000

# 0.50 USDG a buy, 5 USDG a day, nothing under 0.10 USDG, at most one an hour, and never above
# 240 micro-USD for one BRSR: the pool's price of 200 plus a fifth. The ceiling stops being trusted
# seven days after it is set, and governance restates it with Buyback.setParams.
export BURSAR_BUYBACK_SPEND_PER_CALL=500000
export BURSAR_BUYBACK_MAX_SPEND_PER_WINDOW=5000000
export BURSAR_BUYBACK_MIN_SPEND=100000
export BURSAR_BUYBACK_MAX_PRICE_MICRO_USD_PER_BRSR=240
export BURSAR_BUYBACK_WINDOW=86400
export BURSAR_BUYBACK_MIN_INTERVAL=3600

# Who may trigger a buyback. Unset, the first recorded resolver does, until a keeper service
# runs with a key of its own.
# export BURSAR_BUYBACK_KEEPER=

# --- DeployCollateral.s.sol: the credit pool's lender ---

# The only address that can take unlent USDG back out of the credit pool, and the one that carries
# its losses. The deploy key, which funds it.
export BURSAR_LENDER=0x6B6fC40Ed9652728A9B620C4e1B05fBF4F9712a4

# --- DeployPrivacy.s.sol: the solvency log's poster ---

export BURSAR_SOLVENCY_POSTER=0x6B6fC40Ed9652728A9B620C4e1B05fBF4F9712a4

# --- DeployShielded.s.sol: the association-set postman and the relayer ---

export BURSAR_ASP_POSTMAN=0x731F3BbbD40ae5387646A62D5F08C2517aA84bbe
export BURSAR_SHIELDED_RELAYER=0xc8FB46218bA6750EBF8cE7Cc8f7a56D7C7F99630

# --- MigrateExamples.s.sol: who the example mandates pay ---

# The registered payee the earlier examples paid, and the one agent on the old registries.
export BURSAR_EXAMPLE_PAYEE=0x5210D8df060A9D5ce4c1305045ED5c9548fca374

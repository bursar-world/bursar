{
  "name": "@bursar/mcp",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bursar-world/bursar.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://github.com/bursar-world/bursar/tree/main/packages/mcp#readme",
  "bugs": {
    "url": "https://github.com/bursar-world/bursar/issues"
  },
  "type": "module",
  "description": "Model Context Protocol server for BURSAR spending mandates on Robinhood Chain.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "bursar-mcp": "./bin/bursar-mcp.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "start": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@bursar/circuits": "workspace:*",
    "@bursar/core": "workspace:*",
    "@bursar/sdk": "workspace:*",
    "@modelcontextprotocol/sdk": "1.31.0",
    "viem": "2.57.2"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=22"
  }
}

{
  "name": "@bursar/sdk",
  "version": "0.1.2",
  "description": "Agent-side client for Bursar spending mandates, escrowed settlement and x402 payments on Robinhood Chain.",
  "keywords": [
    "bursar",
    "ai-agents",
    "payments",
    "x402",
    "robinhood-chain",
    "usdg"
  ],
  "homepage": "https://github.com/bursar-world/bursar/tree/main/packages/sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bursar-world/bursar.git",
    "directory": "packages/sdk"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/bursar-world/bursar/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./prove": {
      "types": "./dist/prove.d.ts",
      "import": "./dist/prove.js"
    },
    "./shielded-prove": {
      "types": "./dist/shielded-prove.d.ts",
      "import": "./dist/shielded-prove.js"
    },
    "./agent": {
      "types": "./dist/private-agent.d.ts",
      "import": "./dist/private-agent.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@bursar/circuits": "workspace:*",
    "@bursar/core": "workspace:*",
    "@noble/curves": "1.9.1",
    "@noble/hashes": "1.8.0",
    "@zk-kit/lean-imt": "2.2.5",
    "poseidon-lite": "0.3.0",
    "snarkjs": "0.7.6",
    "viem": "2.57.3"
  },
  "devDependencies": {
    "@safe-global/protocol-kit": "8.0.7",
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  }
}

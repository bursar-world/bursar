{
  "name": "@bursar/sdk",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bursar-world/bursar.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://github.com/bursar-world/bursar/tree/main/packages/sdk#readme",
  "bugs": {
    "url": "https://github.com/bursar-world/bursar/issues"
  },
  "description": "Agent-side client for BURSAR spending mandates, escrowed settlement and x402 payments on Robinhood Chain.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./prove": {
      "types": "./dist/prove.d.ts",
      "import": "./dist/prove.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@bursar/core": "workspace:*",
    "viem": "^2.56.9",
    "@bursar/circuits": "workspace:*",
    "@noble/curves": "1.9.1",
    "@noble/hashes": "1.8.0",
    "snarkjs": "0.7.6"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=22"
  }
}

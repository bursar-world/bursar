{
  "name": "@bursar/openai-agents",
  "version": "0.1.0",
  "description": "Spend from a Bursar mandate inside the OpenAI Agents SDK: inspect, quote, pay and settlements as tools.",
  "keywords": [
    "bursar",
    "openai",
    "agents-sdk",
    "ai-agents",
    "payments",
    "robinhood-chain"
  ],
  "homepage": "https://github.com/bursar-world/bursar/tree/main/packages/integrations/openai-agents#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bursar-world/bursar.git",
    "directory": "packages/integrations/openai-agents"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/bursar-world/bursar/issues"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "example": "tsx examples/pay.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@bursar/toolset": "workspace:*"
  },
  "peerDependencies": {
    "@openai/agents": ">=0.19.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "@openai/agents": "0.19.0"
  }
}
